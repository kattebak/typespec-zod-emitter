{
	"name": "@kattebak/typespec-zod-emitter",
	"version": "1.0.0",
	"description": "TypeSpec emitter for Zod validators",
	"type": "module",
	"main": "dist/index.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kattebak/typespec-zod-emitter.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"tsp"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js",
			"typespec": "./tsp/main.tsp"
		}
	},
	"scripts": {
		"fix": "npx @biomejs/biome check --write",
		"lint": "npx @biomejs/biome check",
		"build": "tsc",
		"watch": "tsc --watch",
		"test": "npm run build && npm run lint && npm run test:unit && npm run test:emit && npm run test:example",
		"test:emit": "tsp compile test/main.tsp --config test/tspconfig.yaml",
		"test:package": "npm run test:emit && tsc -p build/zod-schemas",
		"test:example": "npm run test:package && node --test test/example.js",
		"test:unit": "node --test --import=tsx src/**/*.test.ts",
		"prepublishOnly": "tsc"
	},
	"dependencies": {
		"@typespec/compiler": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.7",
		"@typespec/http": "^1.4.0",
		"tsx": "^4.20.5",
		"typescript": "^5.9.3",
		"zod": "^3.0.0"
	},
	"peerDependencies": {
		"@typespec/http": "^1.4.0",
		"zod": "^3.0.0"
	}
}
